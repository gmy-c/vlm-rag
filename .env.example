# VLM-RAG 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# 豆包 Doubao Vision API Key（火山引擎 Ark 平台）
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
DOUBAO_API_KEY=your-doubao-api-key-here

# DocVQA 数据集根目录（可选，默认 data/）
# DOCVQA_DATA_ROOT=data

# 本地 ColPali/PaliGemma checkpoint；setup.sh 不会自动下载权重
# COLPALI_MODEL_PATH=checkpoint

# HuggingFace、PyTorch、pip 和临时文件统一缓存目录
# 建议设置到服务器数据盘，避免占满系统盘
# VLM_CACHE_ROOT=/path/to/data-disk/vlm-cache

# 可选输出目录
# RETRIEVAL_OUTPUT_DIR=models/colpali_retriever
# RAG_OUTPUT_DIR=outputs/rag_evaluation
